    <script>
      (function () {
        try {
          var params = new URLSearchParams(window.location.search);
          var name = params.get('loader');
          var host = params.get('host');
          // Transparent overlay mode is driven by the embedding host (today the
          // math-mission variants). Kept compatible with the legacy `transparent=1` flag.
          var transparent =
            host === 'math-mission' || host === 'math-mission-assessment' || params.get('transparent') === '1';
          if (transparent) {
            document.documentElement.classList.add('solo--transparent');
            document.body.classList.add('solo--transparent');
          }
          var variant = name === 'math-mission' ? 'math-mission' : 'default';
          var tpl = document.getElementById('solo-loader-' + variant) || document.getElementById('solo-loader-default');
          var root = document.getElementById('solo-loader-root');
          if (tpl && root && tpl.content) {
            root.appendChild(tpl.content.cloneNode(true));
          }
          // Transparent variants: let the host page (e.g. math-mission iframe parent) show through.
          if (variant === 'math-mission') {
            document.body.classList.add('solo-loader--transparent');
            // Hide the React root so the nano UI is not visible through the
            // transparent loader until the exit animation has fully played.
            document.body.classList.add('solo-loader--blocking');

            var MM_EXIT_MS = 1100;
            var origStart = document.startViewTransition && document.startViewTransition.bind(document);
            document.startViewTransition = function (cb) {
              var wrapper = document.querySelector('.loading__wrapper--math-mission');
              var reveal = function () {
                try {
                  if (typeof cb === 'function') cb();
                } catch (e) {
                  // ignore
                }
                document.body.classList.remove('solo-loader--blocking');
              };
              if (!wrapper) {
                reveal();
                var done0 = Promise.resolve();
                return { finished: done0, ready: done0, updateCallbackDone: done0, skipTransition: function () {} };
              }
              wrapper.classList.add('mm-loading--exiting');
              setTimeout(reveal, MM_EXIT_MS);
              var done = Promise.resolve();
              return { finished: done, ready: done, updateCallbackDone: done, skipTransition: function () {} };
            };
          }
        } catch (e) {
          // Fall back to no loader; the app will mount over the body background.
        }
      })();
    </script>
