      body.solo-loader--transparent {
        background-color: transparent !important;
      }
      /* Hide the React root (the nano UI) while the loader is still on screen,
         so the user never sees the nano pop in through a transparent loader.
         The class is removed once the loader exit animation has fully played
         and the loader element is about to be removed from the DOM. */
      body.solo-loader--blocking #root {
        visibility: hidden !important;
      }
      /* Transparent overlay mode (?transparent=1): the whole solo app is rendered
         with a transparent body so the parent (iframe host) shows through. */
      html.solo--transparent,
      body.solo--transparent {
        background: transparent !important;
        background-color: transparent !important;
